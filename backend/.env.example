# Server
NODE_ENV=development
PORT=5000

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=engjoy
PG_USER=postgres
PG_PASSWORD=secret

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MongoDB
MONGO_URI=mongodb://localhost:27017/engjoy_dictionary

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173
